{
  "trailingSlash": "always",
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/_next/*", "/images/*", "/assets/*", "/events/*", "/gallery/*", "/fonts/*", "/*.{png,jpg,jpeg,gif,svg,webp,ico,txt,xml,json,woff,woff2,ttf,eot,css,js}"]
  },
  "routes": [
    {
      "route": "/*",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      }
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404/index.html"
    }
  },
  "mimeTypes": {
    ".json": "text/json",
    ".webp": "image/webp"
  }
}
